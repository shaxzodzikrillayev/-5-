# ===== Сервер =====
PORT=5000
NODE_ENV=development

# База данных.
# Если DATABASE_URL задан (например postgres://user:pass@host:5432/db) — используется PostgreSQL.
# Если пусто — используется встроенный SQLite (файл data/dezhurstvo.db, ничего устанавливать не нужно).
DATABASE_URL=
DATABASE_FILE=./data/dezhurstvo.db

# На Vercel файловая система контейнера доступна только для чтения,
# поэтому SQLite автоматически создаётся в /tmp/dezhurstvo.db.
# Укажите DATABASE_URL (PostgreSQL), если нужны постоянные данные.

# Заполнять ли пустую базу демо-данными при старте.
# По умолчанию true только на Vercel без DATABASE_URL, иначе false.
SEED_ON_EMPTY=false

# Секрет для подписи cookie-сессии (обязательный в production).
SESSION_SECRET=change-me-to-a-long-random-string

# Часовой пояс, по которому определяется "сегодня" (IANA). Необязательно.
APP_TIMEZONE=Asia/Tashkent

# ===== Регистрация =====
# Код подтверждения роли. Староста/куратор вводят его при регистрации.
# Ученик регистрируется без кода.
CODE_STAROSTA=STAR-2026
CODE_KURATOR=ADMIN-2026

# Разрешить первому пользователю системы стать куратором без кода (bootstrap).
# После появления первого куратора код всё равно обязателен.
ALLOW_FIRST_KURATOR_BOOTSTRAP=true

# ===== Frontend (только для сборки фронтенда) =====
# URL бэкенда для продакшн-сборки. Пусто = использовать тот же домен (рекомендуется).
VITE_API_URL=